# Copy this file to .env and fill in real values, then restart `expo start`.
# EXPO_PUBLIC_* variables are inlined into the app bundle by Expo automatically
# — that's why the Supabase anon key (which is meant to be public) belongs
# here, and why the service_role key must NEVER be put in this file.

# Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID.
# You need three client IDs (Web application, iOS, Android) — see ../README.md
# for the exact steps. Google sign-in is disabled in the app until these are set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
